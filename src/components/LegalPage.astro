---
import type {Language} from '../data/content';
interface Props {lang:Language;kind:'privacy'|'terms'|'cookies'}
const {lang,kind}=Astro.props;const id=lang==='id';
const labels=id?{privacy:'Kebijakan Privasi',terms:'Ketentuan Layanan',cookies:'Pengaturan Cookie'}:{privacy:'Privacy Policy',terms:'Terms of Use',cookies:'Cookie Settings'};
const home=id?'/':'/en/';const other=id?`/en/${kind}/`:`/${kind}/`;
const sections=id?{
privacy:[['Data teknis','Hosting menerima data permintaan seperti alamat IP dan browser untuk melayani halaman. Panduan ini tidak menyediakan akun, pemesanan, formulir kontak atau alamat email umpan balik.'],['Layanan luar','Google Maps tertanam dan Google Fonts dapat menerima data browser/IP saat dimuat. Prakiraan cuaca diambil server dari Open-Meteo dengan koordinat tempat, bukan lokasi perangkat pengunjung. Google Analytics hanya dimuat setelah persetujuan. Masing-masing penyedia memiliki kebijakan sendiri.'],['Pilihan browser','Pilihan analitik disimpan bila penyimpanan tersedia. Anda dapat menolak atau mengubahnya melalui Pengaturan Cookie; pesan akan menjelaskan bila pilihan tidak berhasil disimpan.']],
terms:[['Panduan independen','Situs ini tidak mewakili operator, pemerintah atau penjual tiket dan tidak menjual tiket.'],['Informasi kunjungan','Jam listing bertanggal, prakiraan dan gambar referensi bukan jaminan layanan, akses atau keselamatan. Konfirmasikan tiket, aturan dan fasilitas dengan pihak yang mengoperasikannya.'],['Konten dan gambar','Sumber dan atribusi gambar lama dipertahankan tanpa klaim bahwa izin penggunaan ulang telah diverifikasi. Teks dan gambar tidak menggantikan petunjuk petugas.']],
cookies:[['Persetujuan analitik','Google Analytics dinonaktifkan sampai Anda menyetujuinya. Situs memakai penyimpanan browser untuk pilihan analitik; bahasa memiliki URL masing-masing. Tidak ada cookie analitik yang diperlukan untuk membaca halaman.'],['Menolak dan mengubah pilihan','Penolakan langsung mematikan analitik pada halaman saat ini. Penanda sesi membantu mempertahankan penolakan dalam tab ini bila tersedia. Jika penyimpanan gagal, jangan menganggap pilihan tersimpan untuk tab atau browser baru.']]
}:{
privacy:[['Technical data','Hosting receives request data such as IP address and browser information to serve pages. This guide provides no account, booking, contact form or feedback email address.'],['External services','Embedded Google Maps and Google Fonts may receive browser/IP data when loaded. The server requests Open-Meteo forecasts using the venue coordinates, not the visitor’s device location. Google Analytics loads only after consent. Each provider has its own policy.'],['Browser choices','Analytics choices are saved when storage is available. Use Cookie Settings to refuse or change consent; a message explains any failure to save.']],
terms:[['Independent guide','This site does not represent the operator, government or a ticket seller and does not sell tickets.'],['Visitor information','Dated listing hours, forecasts and reference images do not guarantee services, access or safety. Confirm tickets, rules and facilities with the party operating them.'],['Content and images','Existing image sources and attribution are retained without claiming that reuse permission has been independently verified. Text and images do not replace staff instructions.']],
cookies:[['Analytics consent','Google Analytics stays disabled until you agree. Browser storage records analytics choices; languages have separate URLs. Analytics cookies are not needed to read the pages.'],['Refusing and changing consent','Refusal disables analytics immediately on this page. A session marker helps retain refusal in this tab where available. If storage fails, do not assume the choice is saved for new tabs or browsers.']]
};
---
<main class="min-h-screen bg-skywash text-ink"><header class="border-b border-canal/15 bg-white px-5 py-5"><div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-4"><a href={home}>← {id?'Kembali ke panduan':'Back to the guide'}</a><a href={other}>{id?'English':'Bahasa Indonesia'}</a></div></header><article class="mx-auto max-w-4xl px-5 py-16"><h1 class="font-display text-5xl md:text-7xl">{labels[kind]}</h1><p class="my-7">{id?'Diperbarui: 19 Oktober 2026':'Updated: 19 October 2026'}</p>{sections[kind].map(([title,body])=><section class="border-t border-canal/20 py-7"><h2 class="font-display text-3xl">{title}</h2><p class="mt-4 leading-7">{body}</p></section>)}{kind==='cookies'&&<section class="border border-canal/20 bg-white p-6"><h2 class="font-display text-3xl">Google Analytics</h2><div class="mt-6 flex flex-wrap gap-4"><button id="accept-analytics" class="bg-canal px-4 py-3 text-white">{id?'Setujui analitik':'Allow analytics'}</button><button id="decline-analytics" class="border border-canal px-4 py-3">{id?'Tolak analitik':'Refuse analytics'}</button></div><p id="cookie-status" role="status" class="mt-4"></p></section>}<nav class="mt-10 flex flex-wrap gap-5">{(['privacy','terms','cookies'] as const).map(page=><a href={`${id?'':'/en'}/${page}/`}>{labels[page]}</a>)}</nav></article></main>
