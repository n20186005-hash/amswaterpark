---
import { site } from "../data/site";
import type { Language } from "../data/content";

interface Props { lang: Language; kind: "privacy" | "terms" | "cookies"; }
const { lang, kind } = Astro.props;
const back = lang === "id" ? "/" : "/en/";
const alternate = lang === "id" ? `/en/${kind}/` : `/${kind}/`;
const labels = lang === "id" ? { back: "Kembali ke panduan", switch: "English", meta: "HUKUM / PANDUAN INDEPENDEN", privacy: "Kebijakan Privasi", terms: "Ketentuan Layanan", cookies: "Pengaturan Cookie", updated: "Terakhir diperbarui: Agustus 2026", contact: "Pertanyaan atau koreksi?", allow: "Tersimpan: analitik diizinkan.", decline: "Tersimpan: analitik ditolak." } : { back: "Back to the guide", switch: "Bahasa Indonesia", meta: "LEGAL / INDEPENDENT GUIDE", privacy: "Privacy Policy", terms: "Terms of Use", cookies: "Cookie Settings", updated: "Last updated: August 2026", contact: "Questions or corrections?", allow: "Saved: analytics allowed.", decline: "Saved: analytics declined." };
const data = lang === "id" ? {
  privacy: [["Informasi yang kami kumpulkan", "Kami hanya mengumpulkan data minimum yang diperlukan untuk menjalankan panduan ini. Data dapat mencakup data penelusuran seperti alamat IP, jenis peramban, dan halaman yang dibuka; cookie dan teknologi serupa; serta informasi yang Anda berikan secara sukarela lewat email umpan balik."], ["Bagaimana kami menggunakan informasi", "Informasi digunakan untuk memperbaiki isi dan pengalaman situs, memahami pola penggunaan secara agregat jika cookie analitik diaktifkan, menanggapi pesan, dan memenuhi kewajiban hukum yang relevan."], ["Layanan pihak ketiga", "Situs menggunakan Google Maps untuk peta lokasi dan dapat memuat Google Analytics hanya setelah persetujuan Anda. Kami juga menautkan sumber publik seperti Traveloka, Instagram, dan Tripadvisor. Masing-masing layanan memiliki kebijakan privasi sendiri."], ["Hak Anda", "Bergantung pada hukum yang berlaku, Anda dapat meminta akses, perbaikan, atau penghapusan informasi yang Anda berikan; menolak pemrosesan tertentu; dan mengajukan keluhan kepada otoritas berwenang."]],
  terms: [["Penggunaan konten", "Dengan menggunakan situs ini, Anda menyetujui ketentuan ini. Situs adalah proyek informasi pengunjung independen dan tidak berafiliasi dengan Amsterdam Waterpark, instansi pemerintah, atau organisasi resmi mana pun."], ["Ketepatan informasi", "Kami berupaya menyajikan sumber publik dengan jelas, tetapi tiket, jam buka, fasilitas, kondisi, dan rute dapat berubah. Selalu konfirmasi detail penting melalui peta, penjual tiket, atau kanal resmi sebelum berangkat."], ["Hak kekayaan intelektual", "Rancangan dan teks orisinal situs dilindungi. Setiap foto memiliki hak cipta pemegang hak atau fotografer asli sebagaimana dinyatakan pada kredit. Peta Google digunakan sesuai ketentuan Google."], ["Batas tanggung jawab", "Situs ini diberikan sebagaimana adanya tanpa jaminan. Kami tidak bertanggung jawab atas kerugian yang timbul dari penggunaan informasi ini atau keputusan perjalanan yang dibuat berdasarkan informasi tersebut."]],
  cookies: [["Cookie penting", "Cookie ini diperlukan untuk mengingat pilihan bahasa dan pengaturan dasar situs. Cookie penting selalu aktif."], ["Cookie analitik", "Jika Anda menyetujui kategori ini, situs memuat Google Analytics untuk membantu kami memahami penggunaan secara agregat dan anonim. Cookie ini tidak diperlukan untuk membaca panduan."], ["Cookie preferensi", "Cookie ini mengingat bahasa pilihan dan status persetujuan analitik Anda. Anda dapat menghapusnya melalui pengaturan peramban."], ["Kontrol persetujuan", "Anda dapat mengubah pilihan kapan saja pada halaman ini. Menonaktifkan cookie analitik tidak membatasi akses terhadap konten inti."]]
} : {
  privacy: [["Information we collect", "We collect only the minimum information needed to run this guide. It may include browsing data such as IP address, browser type, and pages opened; cookies and similar technologies; and information you voluntarily provide by feedback email."], ["How we use information", "Information is used to improve site content and experience, understand aggregate use when analytics cookies are enabled, respond to messages, and meet relevant legal obligations."], ["Third-party services", "The site uses Google Maps for location mapping and may load Google Analytics only after your consent. It also links to public sources such as Traveloka, Instagram, and Tripadvisor. Each service has its own privacy policy."], ["Your rights", "Subject to applicable law, you may request access, correction, or deletion of information you provide; object to certain processing; and complain to an appropriate authority."]],
  terms: [["Content use", "By using this site, you agree to these terms. It is an independent visitor-information project and is not affiliated with Amsterdam Waterpark, any government body, or any official organisation."], ["Information accuracy", "We aim to present public sources clearly, but tickets, opening times, facilities, conditions, and routes can change. Always confirm important details through maps, ticket sellers, or official channels before travelling."], ["Intellectual property", "The site’s original design and writing are protected. Every photograph remains copyrighted to its original photographer or rights holder as stated in its credit. Google Maps is used under Google’s terms."], ["Limitation of liability", "This site is provided as-is without warranties. We are not liable for loss arising from the use of this information or travel decisions based on it."]],
  cookies: [["Essential cookies", "These cookies are needed to remember your language choice and basic site settings. Essential cookies are always active."], ["Analytics cookies", "If you consent to this category, the site loads Google Analytics to help us understand aggregate, anonymous use. These cookies are not required to read the guide."], ["Preference cookies", "These remember your language selection and analytics-consent state. You can clear them in your browser settings."], ["Consent control", "You can change your choice at any time on this page. Disabling analytics cookies does not restrict access to core content."]]
};
const title = labels[kind];
---
<main class="min-h-screen bg-skywash text-ink"><header class="border-b border-canal/15 bg-white/90 px-5 py-5 backdrop-blur lg:px-8"><div class="mx-auto flex max-w-5xl items-center justify-between gap-4"><a href={back} class="text-sm font-extrabold text-canal no-underline">← {labels.back}</a><a href={alternate} class="rounded-full border border-canal/20 px-3 py-2 text-xs font-extrabold text-canal no-underline">◎ {labels.switch}</a></div></header><article class="mx-auto max-w-4xl px-5 py-16 lg:px-8 lg:py-24"><p class="text-[.68rem] font-extrabold tracking-[.18em] text-canal">{labels.meta}</p><h1 class="mt-4 font-display text-6xl leading-[.92] text-ink md:text-8xl">{title}</h1><p class="mt-7 border-y border-canal/15 py-4 text-sm font-bold text-canal">{labels.updated}</p><div class="mt-10 divide-y divide-canal/15 border-y border-canal/15">{data[kind].map(([heading, body], index) => <section class="grid gap-4 py-8 md:grid-cols-[90px_1fr]"><span class="text-sm font-extrabold text-sunorange">0{index + 1}</span><div><h2 class="font-display text-3xl text-ink">{heading}</h2><p class="mt-3 max-w-2xl leading-7 text-ink/70">{body}</p></div></section>)}</div>{kind === "cookies" && <section class="mt-10 border border-canal/20 bg-white p-6"><h2 class="font-display text-3xl text-ink">Google Analytics</h2><p class="mt-2 max-w-xl text-sm leading-7 text-ink/70">{lang === "id" ? "Pilih apakah situs boleh memuat analitik setelah halaman berikutnya dibuka." : "Choose whether the site may load analytics after the next page view."}</p><div class="mt-5 flex flex-wrap gap-3"><button id="accept-analytics" class="bg-canal px-4 py-3 text-sm font-extrabold text-white">{lang === "id" ? "Setujui analitik" : "Allow analytics"}</button><button id="decline-analytics" class="border border-canal/25 px-4 py-3 text-sm font-extrabold text-canal">{lang === "id" ? "Tolak analitik" : "Decline analytics"}</button><span id="cookie-status" class="self-center text-sm font-bold text-ink/60"></span></div><script is:inline define:vars={{ allowText: labels.allow, declineText: labels.decline }}>{`const status = document.querySelector('#cookie-status'); const setChoice = (choice) => { localStorage.setItem('awp-analytics', choice); status.textContent = choice === 'granted' ? allowText : declineText; }; document.querySelector('#accept-analytics')?.addEventListener('click', () => setChoice('granted')); document.querySelector('#decline-analytics')?.addEventListener('click', () => setChoice('denied')); const current = localStorage.getItem('awp-analytics'); if (current) status.textContent = current === 'granted' ? allowText : declineText;`}</script></section>}<div class="mt-12 border-l-4 border-sunorange bg-white/60 p-6 text-sm text-ink/70">{labels.contact} <a href={`mailto:${site.feedbackEmail}`} class="font-bold text-canal">{site.feedbackEmail}</a></div></article></main>
